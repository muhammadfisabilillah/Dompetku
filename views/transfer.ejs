<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DompetKu - Transfer</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, sans-serif; max-width: 600px; margin: 2rem auto; padding: 0 1rem; color: #111; }
    h1 { font-size: 1.5rem; margin-bottom: 1rem; }
    nav { border-bottom: 1px solid #eee; padding-bottom: 0.75rem; margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center; }
    nav a { text-decoration: none; color: #2563eb; font-weight: 500; }
    nav a.active { color: #1d4ed8; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; background: #fff; }
    .result { margin-top: 0.75rem; padding: 0.75rem; border-radius: 4px; font-size: 0.9rem; }
    .result.ok { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .result.err { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    label { display: block; margin-bottom: 0.25rem; font-size: 0.9rem; font-weight: 600; }
    input { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem; margin-bottom: 0.75rem; }
    button { width: 100%; padding: 0.6rem; border: none; border-radius: 4px; background: #2563eb; color: #fff; font-size: 1rem; cursor: pointer; }
    .muted { color: #6b7280; font-size: 0.85rem; }
  </style>
</head>
<body>
  <nav>
    <a href="/<%= api_key ? '?api_key=' + api_key : '' %>">Beranda</a>
    <a href="/register<%= api_key ? '?api_key=' + api_key : '' %>">Daftar</a>
    <a href="/balance<%= api_key ? '?api_key=' + api_key : '' %>">Cek Saldo</a>
    <a href="/topup<%= api_key ? '?api_key=' + api_key : '' %>">Top Up</a>
    <a href="/transfer<%= api_key ? '?api_key=' + api_key : '' %>" class="active">Transfer</a>
    <a href="/transactions<%= api_key ? '?api_key=' + api_key : '' %>">Riwayat</a>
  </nav>

  <h1>Transfer</h1>

  <% if (error) { %><div class="result err"><%- error %></div><% } %>
  <% if (success) { %><div class="result ok"><%- success %></div><% } %>

  <form method="POST" action="/transfer">
    <input type="hidden" name="api_key" value="<%- api_key %>">
    <label>ID Akun Pengirim</label>
    <input type="number" name="from_account_id" placeholder="ID akun Anda" required>
    <label>ID Akun Penerima</label>
    <input type="number" name="to_account_id" placeholder="ID akun tujuan" required>
    <label>Jumlah (min Rp 1.000)</label>
    <input type="number" name="amount" placeholder="10000" required>
    <label>Idempotency Key (opsional)</label>
    <input type="text" name="idempotency_key" placeholder="tidak wajib diisi">
    <button type="submit">Transfer</button>
  </form>
  <p class="muted">Aturan: saldo cukup, tidak boleh transfer ke akun sendiri, batas transfer keluar Rp 2.000.000 per hari.</p>
</body>
</html>