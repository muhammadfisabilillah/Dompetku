<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DompetKu - Riwayat Transaksi</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, sans-serif; max-width: 600px; margin: 2rem auto; padding: 0 1rem; color: #111; }
    h1 { font-size: 1.5rem; margin-bottom: 1rem; }
    nav { border-bottom: 1px solid #eee; padding-bottom: 0.75rem; margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center; }
    nav a { text-decoration: none; color: #2563eb; font-weight: 500; }
    nav a.active { color: #1d4ed8; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; background: #fff; }
    .result { margin-top: 0.75rem; padding: 0.75rem; border-radius: 4px; font-size: 0.9rem; }
    .result.ok { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .result.err { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    label { display: block; margin-bottom: 0.25rem; font-size: 0.9rem; font-weight: 600; }
    input { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem; margin-bottom: 0.75rem; }
    button { width: 100%; padding: 0.6rem; border: none; border-radius: 4px; background: #2563eb; color: #fff; font-size: 1rem; cursor: pointer; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-top: 0.5rem; }
    th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid #eee; }
    th { font-weight: 600; color: #374151; }
    .muted { color: #6b7280; font-size: 0.85rem; }
    .empty { text-align: center; color: #6b7280; padding: 1rem; }
  </style>
</head>
<body>
  <nav>
    <a href="/<%= api_key ? '?api_key=' + api_key : '' %>">Beranda</a>
    <a href="/register<%= api_key ? '?api_key=' + api_key : '' %>">Daftar</a>
    <a href="/balance<%= api_key ? '?api_key=' + api_key : '' %>">Cek Saldo</a>
    <a href="/topup<%= api_key ? '?api_key=' + api_key : '' %>">Top Up</a>
    <a href="/transfer<%= api_key ? '?api_key=' + api_key : '' %>">Transfer</a>
    <a href="/transactions<%= api_key ? '?api_key=' + api_key : '' %>" class="active">Riwayat</a>
  </nav>

  <h1>Riwayat Transaksi</h1>

  <% if (error) { %><div class="result err"><%- error %></div><% } %>

  <% if (account) { %>
    <p><strong>Akun:</strong> <%- account.name %> (<%- account.id %>)</p>
    <% if (transactions.length === 0) { %>
      <div class="empty">Belum ada transaksi.</div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Tanggal</th>
            <th>Tipe</th>
            <th>Dari</th>
            <th>Ke</th>
            <th>Jumlah</th>
            <th>Saldo Sebelum</th>
            <th>Saldo Sesudah</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach(function(t) { %>
            <tr>
              <td><%- new Date(t.created_at).toLocaleString('id-ID') %></td>
              <td><%- t.type %></td>
              <td><%- t.from_account_id || '-' %></td>
              <td><%- t.to_account_id || '-' %></td>
              <td>Rp <%- t.amount.toLocaleString('id-ID') %></td>
              <td>Rp <%- t.balance_before.toLocaleString('id-ID') %></td>
              <td>Rp <%- t.balance_after.toLocaleString('id-ID') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  <% } else { %>
    <form method="GET" action="/transactions">
      <label>API Key</label>
      <input type="text" name="api_key" value="<%- api_key %>" required>
      <button type="submit">Lihat Riwayat</button>
    </form>
    <p class="muted">Masukkan API key yang didapatkan saat registrasi.</p>
  <% } %>
</body>
</html>