# Port aplikasi (default 8000)
PORT=8000

# Database. Di dalam compose, DB_HOST diisi 'db' (service database).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dompetku
DB_PASSWORD=ganti_password_rahasia
DB_NAME=dompetku
NODE_ENV=development

# Dipakai compose.yaml untuk menarik image hasil pipeline dari Docker Hub.
DOCKERHUB_USER=mfisabilillah

# Dipakai compose.test.yaml saat test dijalankan di Jenkins.
TEST_DB_PASSWORD=ci_only_password
