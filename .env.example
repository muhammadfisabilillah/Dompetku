# Salin ke .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit file .env

# --- Aplikasi ---
PORT=8000
NODE_ENV=development

# --- Database ---
# Lokal (npm start langsung): 127.0.0.1. Di Docker Compose nilai ini
# otomatis ditimpa menjadi "db" oleh compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dompetku
# isi password sendiri
DB_PASSWORD=
DB_NAME=dompetku

# --- Docker Hub (dipakai compose.yaml untuk menarik image) ---
DOCKERHUB_USER=
